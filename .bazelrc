common --workspace_status_command="bash tools/workspace-status.sh"

common --incompatible_strict_action_env
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
test --test_output=errors

common:rbe --credential_helper=*.meroton.com=%workspace%/tools/bazel-credential-helper.py
common:rbe --credential_helper_cache_duration=10s
common:rbe --remote_executor=grpcs://rbe.buildbar.meroton.com
common:rbe --remote_instance_name=buildbarn-meetup-2026
common:rbe --host_platform=//platforms:host
common:rbe --extra_execution_platforms=//platforms:ubuntu-24-04
common:rbe --remote_timeout=600s
common:rbe --jobs=256
common:rbe --remote_download_minimal
common:rbe --remote_upload_local_results=false

common:bes --bes_backend=grpcs://bes.buildbar.meroton.com
common:bes --bes_results_url=https://buildbar.meroton.com/bazel-invocations/
common:bes --bes_instance_name=buildbarn-meetup-2026

common --config=rbe --config=bes

try-import %workspace%/.user.bazelrc
